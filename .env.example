# ---- Authentication / free trial ----
# Generate a long random value and keep it server-side only.
AUTH_SECRET=replace_with_a_long_random_secret
TRIAL_DAYS=7

# Recommended: use a different long random value from AUTH_SECRET.
# Used to encrypt customer WhatsApp access tokens and registration metadata.
CREDENTIAL_ENCRYPTION_KEY=replace_with_another_long_random_secret

# ---- Firebase Firestore (accounts, conversations, messages, orders) ----
# Preferred: paste the complete Firebase Admin service-account JSON as one value.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# Alternative: base64-encode the same JSON and use this instead.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ---- Meta / WhatsApp Business Platform ----
WHATSAPP_API_VERSION=v26.0
NEXT_PUBLIC_META_GRAPH_VERSION=v26.0
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
NEXT_PUBLIC_META_CONFIG_ID=your_embedded_signup_configuration_id
META_APP_SECRET=your_meta_app_secret
WHATSAPP_WEBHOOK_TOKEN=replace_with_a_long_random_webhook_verify_token

# ---- Provider-mode Meta settings ----
# Leave provider mode false until your Meta Tech Provider / Solution Partner
# onboarding, permissions and system-user setup are ready.
META_PROVIDER_MODE_ENABLED=false
META_BUSINESS_ID=
META_SYSTEM_USER_ID=
# Ongoing WhatsApp messaging/system-user token with the permissions required by
# your approved provider setup. Never expose this in the browser.
META_SYSTEM_USER_ACCESS_TOKEN=
# Prefer a separate Admin System User token for assigning the provider system
# user to client WABAs. If blank, code falls back to META_SYSTEM_USER_ACCESS_TOKEN.
META_ADMIN_SYSTEM_USER_ACCESS_TOKEN=

# Optional provider credit-line billing. Keep false unless Meta has approved and
# configured this commercial model for your business.
META_PROVIDER_CREDIT_LINE_ENABLED=false
META_CREDIT_LINE_ID=

# ---- Campaign safety ----
# Per-campaign ceiling. Campaigns require Meta-approved templates and recorded
# marketing opt-in. Contacts can additionally be segmented by CRM tag.
CAMPAIGN_MAX_RECIPIENTS=1000

# ---- Email notifications / password reset ----
# Required for Forgot Password / Reset Password emails. Also used for payment
# and plan-activation emails. Keep the API key server-side only.
RESEND_API_KEY=
EMAIL_FROM=WhatsApp Connect Pro <support@your-domain.com>

# ---- Razorpay automatic subscription checkout ----
# When both key values are configured, /checkout offers secure online checkout.
# The key secret remains server-side; payment amount/status/signature are verified
# by the server before the account is activated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure a Razorpay webhook to:
#   https://your-domain.com/api/webhooks/razorpay
# Subscribe at minimum to payment.captured and/or order.paid.
RAZORPAY_WEBHOOK_SECRET=

# ---- Site ----
# Must be the public production origin so reset links and admin email links point
# to the live site.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---- Admin panel ----
# Required. Admin authorization fails closed if neither ADMIN_EMAIL nor
# ADMIN_EMAILS contains the logged-in account.
ADMIN_EMAIL=your-admin@example.com
# Optional comma-separated extra admins.
ADMIN_EMAILS=
